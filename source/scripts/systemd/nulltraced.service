[Unit]
Description=NullTrace local privacy daemon

[Service]
Type=simple
# keep the passphrase in a 0600 file, not on the command line
Environment=NULLTRACE_PASSPHRASE_FILE=%h/.config/nulltrace/passphrase
ExecStart=/usr/local/bin/nulltraced
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
